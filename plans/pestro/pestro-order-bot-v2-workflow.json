      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2880, 900],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.isOrder }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "order"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.isOrder }}", "rightValue": false, "operator": { "type": "boolean", "operation": "false" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "chat"
            }
          ]
        },
        "options": {}
      }
    },
