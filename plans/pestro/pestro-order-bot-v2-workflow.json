    {
      "id": "n30",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 900],
      "parameters": {
        "jsCode": "const output = $input.first().json.output || '';\nconst chatId = $('Find Session').first().json.chatId;\n\nif (!output.includes('##ЗАКАЗ##')) {\n  return [{ json: { isOrder: false, chatId, reply: output } }];\n}\n\nconst orderPart = output.split('##ЗАКАЗ##')[1] || '';\nconst extract = (key) => {\n  const m = orderPart.match(new RegExp(key + ':\\\\s*([^,\\\\n]+)'));\n  return m ? m[1].trim() : '';\n};\n\nreturn [{ json: {\n  isOrder: true,\n  chatId,\n  reply: '✅ Заказ принят! Менеджер свяжется с вами в ближайшее время.',\n  name: extract('имя'),\n  phone: extract('телефон'),\n  address: extract('адрес'),\n  time: extract('время'),\n  product: extract('букет')\n} }];"
      }
    },
