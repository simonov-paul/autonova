            { "id": "step", "displayName": "step", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "flowers", "displayName": "flowers", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "budget", "displayName": "budget", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "selected_product", "displayName": "selected_product", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n17",
      "name": "Send Flower Keyboard",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2660, 160],
      "parameters": {
        "chatId": "={{ $('Find Session').first().json.chatId }}",
        "text": "Привет! 🌸 Добро пожаловать в Pestro.\n\nПодберём красивый букет. Какие цветы предпочитаете?",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "{\"keyboard\":[[{\"text\":\"🌹 Розы\"},{\"text\":\"🌸 Пионы\"}],[{\"text\":\"🌷 Тюльпаны\"},{\"text\":\"💐 Без разницы\"}]],\"one_time_keyboard\":true,\"resize_keyboard\":true}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_CRED_ID", "name": "Telegram Pestro Bot" }
      }
    },

    {
      "id": "n18",
      "name": "Save Flowers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 340],
      "parameters": {
        "jsCode": "const chatId = $json.chatId;\nconst t = ($json.text || '').toLowerCase();\nlet flowers = 'any';\nif (t.includes('роз')) flowers = 'роза';\nelse if (t.includes('пион')) flowers = 'пион';\nelse if (t.includes('тюльп')) flowers = 'тюльпан';\nreturn [{ json: { chatId, flowers } }];"
      }
    },
    {
      "id": "n19",
      "name": "Upsert Session Flowers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2660, 340],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Sessions", "__rl": true, "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "chat_id": "={{ $json.chatId }}",
            "step": "budget",
            "flowers": "={{ $json.flowers }}"
          },
          "matchingColumns": ["chat_id"],
          "schema": [
            { "id": "chat_id", "displayName": "chat_id", "required": false, "defaultMatch": true, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "step", "displayName": "step", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "flowers", "displayName": "flowers", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n20",
      "name": "Send Budget Keyboard",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2880, 340],
      "parameters": {
        "chatId": "={{ $('Save Flowers').first().json.chatId }}",
        "text": "Отлично! 💰 Какой у вас бюджет?",
        "additionalFields": {
          "reply_markup": "{\"keyboard\":[[{\"text\":\"до 10 000 ₽\"},{\"text\":\"до 15 000 ₽\"}],[{\"text\":\"Без ограничений\"}]],\"one_time_keyboard\":true,\"resize_keyboard\":true}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_CRED_ID", "name": "Telegram Pestro Bot" }
      }
    },

    {
      "id": "n21",
      "name": "Save Budget",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 520],
      "parameters": {
        "jsCode": "const chatId = $json.chatId;\nconst flowers = $json.flowers || 'any';\nconst t = $json.text || '';\nlet budget = 0;\nif (t.includes('10')) budget = 10000;\nelse if (t.includes('15')) budget = 15000;\nreturn [{ json: { chatId, flowers, budget } }];"
      }
    },
    {
      "id": "n22",
      "name": "Upsert Session Budget",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2660, 520],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Sessions", "__rl": true, "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "chat_id": "={{ $json.chatId }}",
            "step": "shown",
            "budget": "={{ $json.budget }}"
          },
          "matchingColumns": ["chat_id"],
          "schema": [
            { "id": "chat_id", "displayName": "chat_id", "required": false, "defaultMatch": true, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "step", "displayName": "step", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "budget", "displayName": "budget", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n23",
      "name": "Read Catalog",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2880, 520],
      "parameters": {
        "operation": "read",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "gid=1848969580", "__rl": true, "mode": "id" },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n24",
      "name": "Filter Catalog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3100, 520],
      "parameters": {
        "jsCode": "const saved = $('Save Budget').first().json;\nconst chatId = saved.chatId;\nconst flowers = (saved.flowers || 'any').toLowerCase();\nconst budget = parseInt(saved.budget) || 0;\n\nconst allRows = $input.all().map(r => r.json);\n\nconst filtered = allRows.filter(item => {\n  const price = parseInt(String(item.price || item.Price || 0).replace(/[\\s\\u00a0]/g, '')) || 0;\n  if (budget > 0 && price > budget) return false;\n  if (flowers && flowers !== 'any') {\n    const comp = (item.composition || item.Composition || '').toLowerCase();\n    if (!comp.includes(flowers)) return false;\n  }\n  return true;\n});\n\nconst result = filtered.length > 0 ? filtered.slice(0, 6) : allRows.slice(0, 6);\n\nreturn result.map(item => ({\n  json: {\n    chatId,\n    name: item.name || item.Name || '',\n    price: item.price || item.Price || '',\n    composition: item.composition || item.Composition || '',\n    photo: item.photo || item.Photo || '',\n    callbackData: 'order:' + (item.name || item.Name || '')\n  }\n}));"
      }
    },
    {
      "id": "n25",
      "name": "Send Bouquets",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3320, 520],
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $json.chatId }}",
        "photo": "={{ $json.photo }}",
        "additionalFields": {
          "caption": "=*{{ $json.name }}* — {{ $json.price }} ₽\n\n🌸 {{ $json.composition }}",
          "parse_mode": "Markdown",
          "reply_markup": "={{ JSON.stringify({ inline_keyboard: [[{ text: '🛒 Заказать этот букет', callback_data: $json.callbackData }]] }) }}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_CRED_ID", "name": "Telegram Pestro Bot" }
      }
    },

