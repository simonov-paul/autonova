    {
      "id": "n27",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [2440, 900],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Find Session').first().json.text }}",
        "systemMessage": "=Ты — вежливый помощник цветочного магазина Pestro. Клиент уже выбрал букет: {{ $('Find Session').first().json.selected_product }}.\n\nТвоя задача — последовательно собрать данные для доставки:\n1. Имя клиента\n2. Номер телефона\n3. Адрес доставки\n4. Желаемое время доставки\n\nЗадавай по одному вопросу за раз. Будь дружелюбным и кратким. Не повторяй уже полученную информацию.\n\nКогда все 4 пункта получены, выведи СТРОГО в этом формате без лишнего текста:\n##ЗАКАЗ## имя: {имя}, телефон: {телефон}, адрес: {адрес}, время: {время}, букет: {{ $('Find Session').first().json.selected_product }}",
        "options": {}
      }
    },
