{
  "name": "Pestro — Order Bot v2 (Кнопки)",
  "nodes": [
    {
      "id": "n1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 400],
      "webhookId": "pestro-bot-v2",
      "parameters": {
        "updates": ["message", "callback_query"]
      },
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_CRED_ID", "name": "Telegram Pestro Bot" }
      }
    },
    {
      "id": "n2",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400],
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst msg = body.message;\nconst cbq = body.callback_query;\n\nlet chatId = '', text = '', isVoice = false, isCallback = false, callbackData = '', callbackQueryId = '', fileId = '';\n\nif (cbq) {\n  isCallback = true;\n  chatId = String(cbq.from.id);\n  callbackData = cbq.data || '';\n  callbackQueryId = String(cbq.id);\n} else if (msg) {\n  chatId = String(msg.chat.id);\n  if (msg.voice) {\n    isVoice = true;\n    fileId = msg.voice.file_id;\n  } else {\n    text = msg.text || '';\n  }\n}\n\nreturn [{ json: { chatId, text, isVoice, isCallback, callbackData, callbackQueryId, fileId } }];"
      }
    },
    {
      "id": "n3",
      "name": "Switch — Input Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [680, 400],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.isCallback }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "callback"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.isVoice }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "voice"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.isCallback }}", "rightValue": false, "operator": { "type": "boolean", "operation": "false" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "text"
            }
          ]
        },
        "options": {}
      }
    },

    {
      "id": "n4",
      "name": "Answer Callback Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 160],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot8752051329:AAEAtsm5tYlOwo7hqP2J6Dzr-jhds-nrqsc/answerCallbackQuery",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "callback_query_id", "value": "={{ $('Parse Input').first().json.callbackQueryId }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "Read Sessions CB",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1120, 160],
      "parameters": {
        "operation": "read",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Sessions", "__rl": true, "mode": "name" },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n6",
      "name": "Process Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 160],
      "parameters": {
        "jsCode": "const parsed = $('Parse Input').first().json;\nconst chatId = parsed.chatId;\nconst callbackData = parsed.callbackData;\n\nconst sessionRows = $input.all().map(r => r.json);\nconst session = sessionRows.find(r => String(r.chat_id) === chatId) || {};\n\nlet selectedProduct = '';\nif (callbackData.startsWith('order:')) {\n  selectedProduct = callbackData.replace('order:', '');\n}\n\nreturn [{ json: {\n  chat_id: chatId,\n  step: 'ordering',\n  flowers: session.flowers || '',\n  budget: session.budget || '',\n  selected_product: selectedProduct\n} }];"
      }
    },
    {
      "id": "n7",
      "name": "Upsert Session CB",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1560, 160],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Sessions", "__rl": true, "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "chat_id": "={{ $json.chat_id }}",
            "step": "={{ $json.step }}",
            "flowers": "={{ $json.flowers }}",
            "budget": "={{ $json.budget }}",
            "selected_product": "={{ $json.selected_product }}"
          },
          "matchingColumns": ["chat_id"],
          "schema": [
            { "id": "chat_id", "displayName": "chat_id", "required": false, "defaultMatch": true, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "step", "displayName": "step", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "flowers", "displayName": "flowers", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "budget", "displayName": "budget", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "selected_product", "displayName": "selected_product", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n8",
      "name": "Send Ordering Intro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1780, 160],
      "parameters": {
        "chatId": "={{ $('Process Callback').first().json.chat_id }}",
        "text": "=Отличный выбор! 🌸\n\nВы выбрали *{{ $('Process Callback').first().json.selected_product }}*.\n\nДавайте оформим доставку. Как вас зовут?",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_CRED_ID", "name": "Telegram Pestro Bot" }
      }
    },

    {
      "id": "n9",
      "name": "Get Voice File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 400],
      "parameters": {
        "operation": "getFile",
        "fileId": "={{ $('Parse Input').first().json.fileId }}"
      },
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_CRED_ID", "name": "Telegram Pestro Bot" }
      }
    },
    {
      "id": "n10",
      "name": "Download Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400],
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/file/bot8752051329:AAEAtsm5tYlOwo7hqP2J6Dzr-jhds-nrqsc/{{ $json.result.file_path }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      }
    },
    {
      "id": "n11",
      "name": "Groq Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer 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" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "file", "value": "={{ $binary.data }}", "parameterType": "formBinaryData" },
            { "name": "model", "value": "whisper-large-v3-turbo" },
            { "name": "language", "value": "ru" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n12",
      "name": "Extract Transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 400],
      "parameters": {
        "jsCode": "const transcription = $input.first().json.text || '';\nconst chatId = $('Parse Input').first().json.chatId;\nreturn [{ json: { chatId, text: transcription } }];"
      }
    },

    {
      "id": "n13",
      "name": "Read Sessions",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1780, 400],
      "parameters": {
        "operation": "read",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Sessions", "__rl": true, "mode": "name" },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GOOGLE_CRED_ID", "name": "Google Sheets account" }
      }
    },
    {
      "id": "n14",
      "name": "Find Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 400],
      "parameters": {
        "jsCode": "let chatId = '', text = '';\ntry {\n  const et = $('Extract Transcription').first().json;\n  chatId = et.chatId; text = et.text || '';\n} catch(e) {}\nif (!chatId) {\n  try {\n    const pi = $('Parse Input').first().json;\n    chatId = pi.chatId; text = pi.text || '';\n  } catch(e) {}\n}\n\nconst allSessions = $input.all().map(r => r.json);\nconst session = allSessions.find(r => String(r.chat_id) === chatId);\nconst step = (text === '/start' || !session) ? 'start' : (session.step || 'start');\n\nreturn [{ json: {\n  chatId,\n  text,\n  step,\n  flowers: session ? (session.flowers || '') : '',\n  budget: session ? (session.budget || '') : '',\n  selected_product: session ? (session.selected_product || '') : ''\n} }];"
      }
    },
    {
      "id": "n15",
      "name": "Switch — Step",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2220, 400],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.step }}", "rightValue": "start", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "start"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.step }}", "rightValue": "flowers", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "flowers"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.step }}", "rightValue": "budget", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "budget"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.step }}", "rightValue": "shown", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "shown"
            },
            {
              "conditions": {
                "conditions": [{ "leftValue": "={{ $json.step }}", "rightValue": "ordering", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ordering"
            }
          ]
        },
        "options": { "fallbackOutput": "extra-output-0" }
      }
    },

    {
      "id": "n16",
      "name": "Upsert Session Start",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2440, 160],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "value": "1ruiJaRNv24DGgELZcd1LKkEqe1Otrj85RvQ2zxzQgE8", "__rl": true, "mode": "id" },
        "sheetName": { "value": "Sessions", "__rl": true, "mode": "name" },
        "columns": {
